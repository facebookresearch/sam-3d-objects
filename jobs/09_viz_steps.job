#!/bin/bash
#SBATCH --partition=rome
#SBATCH --job-name=sam_viz_steps
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=logs/sam_viz_steps_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"
export WARP_DISABLE_CUDA=1
export CUDA_VISIBLE_DEVICES=""

DATA="data/Open3DHOI/data"

declare -A SAMPLE_DIRS=(
    [coffee_cup]="${DATA}/coffee cup/drinking_98"
    [wrench]="${DATA}/wrench/wrench"
    [chair]="${DATA}/chair/2398495"
)

mkdir -p logs

for sample in coffee_cup wrench chair; do
    SAMPLE_DIR="${SAMPLE_DIRS[$sample]}"
    for cfg in baseline ss_0.1 ss_0.2 ss_0.5 pose_0.05 pose_0.1 pose_0.2 pose_0.5 depth_0.1 depth_0.2 depth_0.5; do
        STEPS_DIR="outputs/sweep/${cfg}/${sample}"
        if [ ! -d "$STEPS_DIR" ]; then
            echo "SKIP ${cfg}/${sample} — no output dir"
            continue
        fi
        echo "=== Viz: ${cfg} / ${sample} ==="
        python scripts/compare_steps.py \
            --steps-dir "$STEPS_DIR" \
            --mask      "${SAMPLE_DIR}/obj_mask.png" \
            --image     "${SAMPLE_DIR}/image.jpg" \
            --depth-map "${SAMPLE_DIR}/depth.npy" \
            --device    cpu
        echo ""
    done
done

echo "=== 09_viz_steps DONE ==="
