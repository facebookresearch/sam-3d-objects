#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=sam_inspect_top30
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=logs/sam_inspect_top30_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1 2>/dev/null || true

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"

mkdir -p logs

echo "=== Collect top 30 worst + bottom 10 best ==="
python scripts/collect_top30_worst.py --worst 10 --best 10

echo ""
echo "=== Export normalized + ICP aligned meshes ==="
python scripts/export_normalized.py --device cuda

echo ""
echo "=== Copy air cushion example (has pose_params.pt) ==="
EXAMPLE=outputs/inspection/example_with_pose/air_cushion_floating_94
mkdir -p "$EXAMPLE"
cp data/Open3DHOI/data/"air cushion"/floating_94/object_mesh.obj "$EXAMPLE/gt.obj"
cp data/Open3DHOI/data/"air cushion"/floating_94/image.jpg        "$EXAMPLE/image.jpg"
cp data/Open3DHOI/data/"air cushion"/floating_94/obj_mask.png     "$EXAMPLE/mask.png"
cp outputs/baseline_all/"air cushion"/floating_94/pred_mesh.obj   "$EXAMPLE/pred.obj"
cp outputs/baseline_all/"air cushion"/floating_94/pose_params.pt  "$EXAMPLE/pose_params.pt"
echo "Copied to $EXAMPLE"

echo ""
echo "=== 13_inspect_top30 DONE ==="
