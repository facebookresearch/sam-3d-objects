#!/bin/bash
#SBATCH --partition=genoa
#SBATCH --job-name=sam_eval_sweep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=logs/sam_eval_sweep_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"

mkdir -p logs

echo "=== Eval sweep ==="
python eval_sweep.py --device cpu

echo ""
echo "=== 08_eval_sweep DONE ==="
